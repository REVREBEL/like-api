{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "like-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-21",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revrebel-like-api-db",
      "database_id": "PASTE_DATABASE_ID_HERE"
    }
  ]
}
